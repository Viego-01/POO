<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="250.0" prefWidth="380.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.ejercicio1_1.PrimaryController">
   <children>
      <Label layoutX="30.0" layoutY="40.0" text="Fecha de nacimiento" />
      <TextField fx:id="txtFecha" layoutX="170.0" layoutY="36.0" prefWidth="150.0" promptText="dd/mm/aaaa" />
      
      <Button fx:id="btnCalcular" layoutX="50.0" layoutY="95.0" onAction="#hazCalcular" prefWidth="80.0" text="Calcular" />
      <Button fx:id="btnLimpiar" layoutX="150.0" layoutY="95.0" onAction="#hazLimpiar" prefWidth="80.0" text="Limpiar" />
      
      <Label fx:id="lblResultado" layoutX="60.0" layoutY="160.0" text="Tiene 0 años con 0 meses" />
   </children>
</AnchorPane>
