<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>


<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.nomina.PrimaryController">
   <children>
       
      <Label text="Base" />
      <TextArea fx:id="txt1" text="9000"/>
      <Label text="Horas Extra" />
      <TextField fx:id="txt2"/>
      
      <Button fx:id="btn1" text="Calcular" onAction="#btnCalcular"/>
      
      <Label text="Pago extra" />
      <TextField fx:id="txt3" />
      <Label text="Subtotal" />
      <TextField fx:id="txt4"/>
      <Label text="ISR (16%)" />
      <TextField fx:id="txt5"/>
      <Label text="NETO" />
      <TextField fx:id="txt6"/>
      
     
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
